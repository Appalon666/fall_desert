{
  "name": "yadryon-pustosh",
  "version": "0.3.0",
  "description": "Ядрён-Пустошь — пост-апок экшен-кликер с юмором (Phaser 3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node sim/balance-sim.mjs",
    "sim:depth": "node sim/depth-sim.mjs",
    "lint": "eslint src sim tests",
    "sim:stability": "node sim/stability.mjs",
    "sim:gear": "node sim/gear-sim.mjs",
    "shots": "node tools/shots.mjs",
    "check:audio": "node tools/audio-check.mjs",
    "check:ads": "node tools/ads-check.mjs",
    "check:score": "node tools/score-check.mjs",
    "check:boss": "node tools/boss-check.mjs",
    "check:smoke": "node tools/smoke-check.mjs",
    "pack": "vite build && python tools/pack.py"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  }
}
